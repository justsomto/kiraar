# ==========================================================================
#  .env.example — Template for environment variables
#  Copy this file to .env and fill in your real values.
#  NEVER share your real .env file publicly.
# ==========================================================================

# Flask Secret Key (generate a strong random string)
SECRET_KEY=your-very-long-random-secret-key-here

# Database Connection (use PostgreSQL URL on Render/Railway)
SQLALCHEMY_DATABASE_URI=postgresql://user:password@host/dbname

# CometChat (from CometChat dashboard)
COMETCHAT_APP_ID=your-cometchat-app-id
COMETCHAT_REGION=eu
COMETCHAT_AUTH_KEY=your-cometchat-auth-key

# Paystack (switch to live keys before going live!)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
